pkgname=ytm-rs
pkgver=0.1.0
pkgrel=1
pkgdesc='YouTube Music TUI and background daemon for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/jeansbitencourt/ytm-rs'
license=('MIT')
depends=('mpv' 'yt-dlp' 'gcc-libs' 'alsa-lib' 'dbus')
optdepends=(
  'foot: terminal padrão recomendado no Omarchy (suporte nativo a Sixel e regras de janela)'
  'kitty: emulador de terminal com suporte ao Kitty Graphics Protocol'
  'ghostty: emulador de terminal moderno com aceleração por GPU'
  'alacritty: emulador de terminal rápido (renderização de capas via halfblocks)'
)
makedepends=('cargo')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ytm-rs "$pkgdir/usr/bin/ytm-rs"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/ytm-rs.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ytm-rs.svg"
  install -Dm644 "$startdir/ytm-rs.desktop" "$pkgdir/usr/share/applications/ytm-rs.desktop"
}
